{
    "exclude": [
        "**/node_modules",
        "**/__pycache__",
        ".venv",
        "**/__pyrefly_virtual__/**",
        "F:/__pyrefly_virtual__/**"
    ],
    "venvPath": ".",
    "venv": ".venv",
    "executionEnvironments": [
        {
            "root": "src",
            "extraPaths": [
                "../vendor/ete4"
            ]
        }
    ],
    "extraPaths": [
        "./src",
        "./vendor/ete4",
        "./vendor/ete4/ete4"
    ],
    "reportMissingImports": "warning",
    "reportMissingTypeStubs": "none",
    "pythonVersion": "3.13",
    "pythonPlatform": "Windows"
}
