*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/
build/
dist/
*.spec
__pyrefly_virtual__/

